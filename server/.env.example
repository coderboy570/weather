# ============================================================
#  SERVER ENVIRONMENT VARIABLES  (copy this file to `.env`)
# ============================================================
# This project uses Open-Meteo, which is FREE and requires NO API KEY
# for non-commercial use. So there is nothing you MUST fill in to run it.
#
# The variables below are optional tuning + an optional OpenWeather key
# (only needed if you switch providers — see README "Switching provider").
# ------------------------------------------------------------

# Port the backend listens on
PORT=5000

# "development" or "production"
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (CORS).
# In development the Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long (seconds) to cache upstream weather responses in memory.
WEATHER_CACHE_TTL_SECONDS=300

# How long (seconds) to cache geocoding lookups (place names rarely change).
GEO_CACHE_TTL_SECONDS=86400

# Per-IP rate limit for the /api routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Timeout (ms) for outbound requests to the weather provider.
UPSTREAM_TIMEOUT_MS=10000

# Upstream provider base URLs (rarely need changing).
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# --- OPTIONAL: only if you switch to OpenWeather (see README) ---
# WEATHER_PROVIDER=open-meteo
# OPENWEATHER_API_KEY=
